# Copy to .env for local development. Never commit .env.

# AWS (local runs only; on Lambda the execution role is used)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Postgres
DATABASE_ENDPOINT=localhost
DATABASE_PORT=5432
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
# Use "disable" for a local Docker Postgres, "require" for RDS
DATABASE_SSLMODE=require

# S3 bucket for CSV uploads
CSV_BUCKET_NAME=

# Shared secret sent as the X-API-Key header (required on Lambda).
# Generate one with: openssl rand -hex 32
API_KEY=

# api (default) or csv-processor
APP_MODE=api
PORT=8080
